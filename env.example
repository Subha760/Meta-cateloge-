# Copy to .env for local testing — on Render, set these as Environment Variables instead

SHESCALE_API_BASE_URL=https://api.shescale.in/api/v1/partner/v1
SHESCALE_API_KEY=your_shescale_api_key_here

SITE_BASE_URL=https://store.choicematrix.in
DEFAULT_ORIGIN_COUNTRY=IN
CURRENCY=INR

# Matches the markup applied on your SheScale WooCommerce plugin settings —
# keep these in sync so Meta shows the same price as your actual store
MARKUP_TYPE=percent
MARKUP_VALUE=30

# When true, pushes the computed price to your SheScale shop listing on
# every feed refresh, so Meta's catalog price always matches checkout.
# Set to false if you'd rather manage prices manually on SheScale.
SYNC_PRICE_TO_SHOP=true

CACHE_TTL_MINUTES=30
REFRESH_SECRET=choose_a_random_string_here

# WhatsApp Cloud API — for receiving orders placed via your catalog or
# click-to-WhatsApp ads. Get these from Meta for Developers → your
# WhatsApp Business app → API Setup.
WHATSAPP_VERIFY_TOKEN=choose_a_random_string_here
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# SheScale → Integrations → API & Webhooks → paste the URL there and put
# the secret it shows you here
SHESCALE_WEBHOOK_SECRET=paste_the_secret_shescale_shows_you

# Meta Conversions API — server-side purchase tracking since we can't
# install a pixel on the SheScale-hosted storefront directly
META_PIXEL_ID=your_meta_pixel_id
META_CAPI_ACCESS_TOKEN=your_conversions_api_access_token
